<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The privileged half of ITAdmin. Installed as a Windows service running as LocalSystem and
         reachable only over an ACL'd local named pipe. It is deliberately NOT part of the web
         payload: it ships as its own directory under Program Files so the app pool identity has no
         path to its binaries, its configuration, or the deploy key it uses. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ITAdmin.HostAgent</AssemblyName>
    <RootNamespace>ITAdmin.HostAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The privilege boundary is asserted directly by unit tests rather than inferred from how
         the service happens to be wired. -->
    <InternalsVisibleTo Include="ITAdmin.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ITAdmin.Deployment\ITAdmin.Deployment.csproj" />
    <ProjectReference Include="..\ITAdmin.HostAgent.Contracts\ITAdmin.HostAgent.Contracts.csproj" />
  </ItemGroup>

</Project>
