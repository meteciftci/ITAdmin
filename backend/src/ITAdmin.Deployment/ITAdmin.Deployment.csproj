<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Library for the deployment contract, and the build-time CLI that produces a release
         artifact from it. One implementation, used by the build and covered by unit tests. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>itadmin-release</AssemblyName>
    <RootNamespace>ITAdmin.Deployment</RootNamespace>
  </PropertyGroup>

</Project>
