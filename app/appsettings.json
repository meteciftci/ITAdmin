{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/itadmin-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "ITAdmin API"
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "ITAdmin",
    "Audience": "ITAdmin.Client",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "DataProtection": {
    "ApplicationName": "ITAdmin",
    "KeysPath": "",
    "CertificateThumbprint": ""
  },
  "Security": {
    "LoginRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "NotificationOutbox": {
    "WorkerEnabled": true,
    "PollIntervalSeconds": 15,
    "BatchSize": 20,
    "ProcessingLockTimeoutMinutes": 10
  }
}
