# ITAdmin — local development environment template.
#
# Copy this file to `.env.development` and adjust if a value clashes with something already
# running on your machine. `.env.development` is gitignored: it is the only place local runtime
# values live, so nothing developers edit can be committed by accident.
#
#   cp .env.development.example .env.development
#
# These values are for a throwaway loopback container on your own machine. They are NOT used by
# production packaging, the installer, or IIS configuration — production secrets come from IIS
# App Pool environment variables and are never stored in this repository.

# --- Local PostgreSQL development container -------------------------------------------------
# Deliberately not 5432, so the dev container cannot collide with a real PostgreSQL install.
ITADMIN_DEV_POSTGRES_HOST=127.0.0.1
ITADMIN_DEV_POSTGRES_PORT=55432
ITADMIN_DEV_POSTGRES_DB=itadmin_dev
ITADMIN_DEV_POSTGRES_USER=itadmin_dev
ITADMIN_DEV_POSTGRES_PASSWORD=itadmin_dev_only

# --- Local API ---------------------------------------------------------------------------------
# Loopback only: the development API is never exposed on a routable interface.
ITADMIN_DEV_API_URL=http://127.0.0.1:5263

# Development-only JWT signing key. Startup fails if no key is provided, so one must be present
# here. Any local value works; it has no meaning outside your machine.
ITADMIN_DEV_JWT_KEY=itadmin-local-development-signing-key-change-before-production

# Outbox worker stays off locally so a dev run never dispatches real email or SMS.
ITADMIN_DEV_NOTIFICATION_WORKER_ENABLED=false

# --- First-run directory bootstrap (optional) ------------------------------------------------
# There is no in-application setup wizard. To make a fresh local database logged-in-able, run
# `./scripts/dev/bootstrap-directory.zsh` once after `start-backend.zsh`; it drives the same
# `ITAdmin.Api.exe --bootstrap-directory` path the Windows installer uses. It needs a reachable
# LDAP/AD to bind against - fill these in when you have one.
ITADMIN_DEV_LDAP_HOST=
ITADMIN_DEV_LDAP_BASE_DN=
ITADMIN_DEV_LDAP_BIND_USER=
ITADMIN_DEV_LDAP_BIND_DOMAIN=
ITADMIN_DEV_LDAP_BIND_PASSWORD=
ITADMIN_DEV_INITIAL_ADMIN=
